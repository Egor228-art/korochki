{
  "version": 2,
  "buildCommand": "echo 'Static files only'",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/components/:file", "destination": "/components/:file" },
    { "source": "/data/:file", "destination": "/data/:file" },
    { "source": "/js/:file", "destination": "/js/:file" }
  ]
}